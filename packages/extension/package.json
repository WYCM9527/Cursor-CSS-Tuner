{
  "name": "cursor-css-tuner",
  "displayName": "Cursor CSS Tuner",
  "description": "Pick elements in Cursor's built-in browser, tune their CSS, edit their text and component props, and reorder them with live preview, then write the changes back to your source code, with one-click revert for each change.",
  "version": "0.11.1",
  "publisher": "WYCM9527",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WYCM9527/Cursor-CSS-Tuner.git",
    "directory": "packages/extension"
  },
  "homepage": "https://github.com/WYCM9527/Cursor-CSS-Tuner#readme",
  "bugs": {
    "url": "https://github.com/WYCM9527/Cursor-CSS-Tuner/issues"
  },
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#141414",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "cursor",
    "css",
    "tailwind",
    "tailwindcss",
    "visual editor",
    "live preview",
    "react",
    "nextjs",
    "css modules",
    "i18n",
    "props",
    "design"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cssTuner",
          "title": "CSS Tuner",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cssTuner": [
        {
          "type": "webview",
          "id": "cssTuner.panel",
          "name": "%view.panel%"
        }
      ]
    },
    "commands": [
      { "command": "cssTuner.openPage", "title": "%command.openPage%", "category": "CSS Tuner" },
      { "command": "cssTuner.togglePick", "title": "%command.togglePick%", "category": "CSS Tuner" },
      { "command": "cssTuner.toggleMeasure", "title": "%command.toggleMeasure%", "category": "CSS Tuner" },
      { "command": "cssTuner.applyAll", "title": "%command.applyAll%", "category": "CSS Tuner" },
      { "command": "cssTuner.serveStatic", "title": "%command.serveStatic%", "category": "CSS Tuner" },
      { "command": "cssTuner.selfCheck", "title": "%command.selfCheck%", "category": "CSS Tuner" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "cssTuner.serveStatic", "when": "resourceExtname == .html || resourceExtname == .htm || explorerResourceIsFolder", "group": "navigation@90" }
      ]
    },
    "configuration": {
      "title": "CSS Tuner",
      "properties": {
        "cssTuner.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.zh-CN%",
            "%config.language.en%"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "cssTuner.defaultUrl": {
          "type": "string",
          "default": "http://localhost:5173/",
          "description": "%config.defaultUrl%"
        },
        "cssTuner.remBase": {
          "type": "number",
          "default": 16,
          "description": "%config.remBase%"
        },
        "cssTuner.tailwind.scope": {
          "type": "string",
          "enum": ["instance", "source"],
          "enumDescriptions": ["%config.tailwind.scope.instance%", "%config.tailwind.scope.source%"],
          "default": "instance",
          "description": "%config.tailwind.scope%"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --out dist/cursor-css-tuner.vsix",
    "publish:ovsx": "ovsx publish dist/cursor-css-tuner.vsix"
  },
  "dependencies": {
    "@css-tuner/engine": "workspace:*",
    "@css-tuner/protocol": "workspace:*",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@css-tuner/bridge": "workspace:*",
    "@css-tuner/panel": "workspace:*",
    "@types/vscode": "~1.100.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.1.0",
    "ovsx": "^1.3.0"
  }
}
